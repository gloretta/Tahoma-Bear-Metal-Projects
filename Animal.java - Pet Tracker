public class Animal {
    String name = "";
    int age = 0;


    public Animal(String name, int age) {
        this.name = name;
        this.age = age;
    }

    void makeSound() {
        System.out.println("The animal makes a sound.");
    }

    void printDetails() {
        System.out.println("Animal Name: " + name);
        System.out.println("Animal Age: " + age);
    }

}
